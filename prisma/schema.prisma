// Multi-document 数据库表结构（后端化：store.json → MySQL）
// 对应关系：原 dataStore.ts 中各 interface 的落库版本
//   Project        → projects（含原全局 categories 层字段，项目辅助）
//   ProjectProduct → products（+ doc_categories 目录树）
//   DocDetail      → documents（文档主表，只存当前态）+ doc_placements（文档挂多个项目）
//   DocRevision    → doc_revisions（历史表，每次发布一条不可变快照）
//   AdminUser/Role → users / roles

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  // 连接串在 prisma.config.ts 里配（Prisma 7 起 url 不再写在 schema）
}

// 状态枚举：DB 层拒绝非法值，比字符串列多一道硬约束（应用层已只用这些取值）
enum DocStatus {
  draft
  published
}

enum UserStatus {
  active
  disabled
}

// ── 项目（辅助层）──────────────────────────────────────────
model Project {
  id                  String    @id // "proj-xxx" / 沿用原 slug 风格
  slug                String    @unique
  name                String
  description         String    @db.Text
  company             String?
  brandName           String?
  productGroups       Json? // string[]
  hiddenProductGroups Json? // string[]
  groupIcons          Json? // Record<string,string>
  legacyAliases       Json? // [{alias, productId}]，原 legacyProjectAliases（旧链接跳转用）
  /// 项目自定义字段/变量 [{key,label,value}]，文档里可用 {{key}} 引用，随项目渲染
  customFields        Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime
  products            Product[]
  placements          DocPlacement[]

  @@map("projects")
}

// ── 产品（项目下的文档分组单元）────────────────────────────
model Product {
  id          String        @id
  projectId   String
  // 级联删除：删项目时连带产品（及产品下的分类/文档/挂载点，各自再级联）
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String        @db.Text
  group       String
  media       Json? // { url, type: "image"|"video" }
  docOrder    Json? // string[]，目录内文档排序
  categories  DocCategory[]
  placements  DocPlacement[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime

  @@unique([projectId, slug])
  @@map("products")
}


// ── 目录树（原 DocCategory，挂在产品下）────────────────────
model DocCategory {
  id        String        @id
  productId String
  // 级联删除：删产品时连带分类
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  icon      String?
  hidden    Boolean       @default(false)
  parentId  String?
  parent    DocCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  DocCategory[] @relation("CategoryTree")
  placements DocPlacement[]

  @@index([productId])
  @@map("doc_categories")
}

// ── 文档主表（核心：只存"当前态"）──────────────────────────
// 同一 (productId, slug) 最多两行：published（已发布态）+ draft（编辑中草稿）
// 两行 id 不同（草稿独立 id，发布时沿用已发布行 id）——id 是主键，不能两行共用
model Document {
  id          String         @id
  // 存储位置键：真实产品 id，或文档库的虚拟锚点 "library"（后台新建文档/复制项目
  // 都用它）。与 doc_tree_nodes.productId 同一语义——逻辑引用，不做外键，
  // 否则 library 文档根本写不进库。真实归属关系在 placements 里（那里有外键）。
  productId   String
  slug        String
  title       String
  description String?        @db.Text
  content     String         @db.LongText // 纯 Markdown 源
  status      DocStatus      @default(draft) // draft | published
  version     Int            @default(1)
  breadcrumbs Json? // string[]
  hidden      Boolean        @default(false)
  changeNote  String?        @db.Text
  appearance  Json? // 编辑器外观配置
  placements  DocPlacement[]
  revisions   DocRevision[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime

  @@unique([productId, slug, status])
  @@map("documents")
}

// ── 文档挂载（一篇文档可出现在多个项目/目录）────────────────
model DocPlacement {
  id         String   @id
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String?
  // 挂载点只在锚点存在时有意义：分类被删则该挂载行随之删除（文档本体不受影响）
  category   DocCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([projectId, productId])
  @@map("doc_placements")
}

// ── 历史表（核心：每次发布一条不可变快照）──────────────────
model DocRevision {
  id          String   @id
  docId       String
  document    Document @relation(fields: [docId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  summary     String   @db.Text // 发布时的变更摘要
  changes     Json // string[]
  placements  Json // 发布时的挂载点快照
  content     String   @db.LongText // 发布时的正文快照
  appearance  Json?
  baseline    Boolean  @default(false) // 基线版本（迁移自旧系统的首个版本）
  /// 发布人（用户名），留痕审计用；迁移基线等历史行可为空
  createdBy   String?
  publishedAt DateTime

  // 按条目 id 去重，不按 (docId, version) 唯一：这张表既存发布快照也存"绑定已有文档"
  // 这类动态条目，后者沿用 published.version，同 (docId, version) 多条是原生语义
  @@index([docId, version])
  @@index([docId, publishedAt])
  @@map("doc_revisions")
}

// ── 应用级杂项设置（全局产品分类层、schemaVersion 等旧字段）──
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime

  @@map("app_settings")
}

// ── 用户 / 角色 ────────────────────────────────────────────
model Role {
  id          String   @id
  name        String
  description String?  @db.Text
  color       String?
  permissions Json // string[]，8 种权限枚举见 src/lib/authTypes.ts
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  users       User[]

  @@map("roles")
}

model User {
  id           String    @id
  username     String    @unique
  name         String
  passwordHash String
  salt         String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  status       UserStatus @default(active) // active | disabled
  customPermissions Json? // 用户级权限覆盖（原 AdminUser.customPermissions）
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@map("users")
}
