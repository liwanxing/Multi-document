# 生产部署配置模板：复制为 .env 后填真实值，chmod 600
#   cp .env.example .env && chmod 600 .env
# .env 不进 git（见 .gitignore），也不会打进镜像（见 .dockerignore）

# ── 必填 ────────────────────────────────────────────────

# MySQL root 密码。只在首次初始化 data/mysql 时写入数据库文件，
# 之后改这里不会改数据库里的密码，还会导致连不上。
MYSQL_PASSWORD=replace-with-strong-password

# 会话签名密钥。生成：openssl rand -hex 32
# 换掉这个值会让所有已登录会话立即失效。
ADMIN_AUTH_SECRET=replace-with-random-secret

# ── 选填 ────────────────────────────────────────────────

# 库名，默认 multi_document
MYSQL_DATABASE=multi_document

# 是否灌入演示数据（"中广云 + 大数据"两个站点）。
# 全新空库才生效，库非空自动跳过；强制重灌设 SEED_DEMO_FORCE=1
SEED_DEMO=true

# 部署的镜像 tag，与 scripts/build-image.sh 产出的 tag 一致（默认取 git 短 sha）
IMAGE_TAG=latest

# 是否只允许 HTTPS 传递会话 Cookie。
# 纯 HTTP 访问（如 http://111.6.204.37:8080）必须为 false，
# 否则浏览器丢弃 Cookie，表现为"登录成功但不跳转"。
COOKIE_SECURE=false
